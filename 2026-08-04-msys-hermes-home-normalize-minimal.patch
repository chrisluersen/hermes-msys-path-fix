+def _normalize_hermes_home_env(raw: str) -> str:
+    """Normalize MSYS-style env values to Windows form before Path() construction.
+
+    Under git-bash, MSYS converts Win32 env vars to POSIX form when spawning
+    native Python (e.g. ``HERMES_HOME=/c/Users/<user>/AppData/Local/hermes``).
+    A bare ``Path()`` then mangles the leading ``/c`` into a rooted relative
+    path (``\\c\\Users\\...``), silently pointing at a non-existent shadow tree
+    -- which breaks board enumeration and can create junk ``C:\\c\\...`` dirs.
+    Convert ``/x/...`` -> ``X:/...`` on win32 only; POSIX systems pass through.
+    """
+    if sys.platform == "win32" and len(raw) >= 3 and raw[0] == "/" and raw[1].isalpha() and raw[2] == "/":
+        return f"{raw[1].upper()}:/{raw[3:]}"
+    return raw
+
+
 def _hermes_home_from_env() -> Path:
     """Resolve HERMES_HOME from the process environment only.
 
